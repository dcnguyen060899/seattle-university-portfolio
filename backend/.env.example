# Copy to backend/.env for local development (python-dotenv loads it from backend/src/app.py).
# Leave ANTHROPIC_API_KEY empty to run the evaluation backend in degraded (rule-based) mode.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Evaluation backend (all optional; defaults shown)
# EVAL_MODEL=claude-sonnet-5        # overrides ANTHROPIC_MODEL for the judge only
# EVAL_EFFORT=medium                # low | medium | high | xhigh | max
# EVAL_MAX_TOKENS=16000             # 1024..32000
# EVAL_TIMEOUT_S=40                 # SDK request timeout in seconds
# EVAL_AI_DISABLED=0                # 1 forces degraded mode even with a key
# EVAL_RATE_PER_MIN=10              # per-IP token bucket (burst 5)
# ALLOWED_ORIGINS=https://duyng-portfolio.com,https://www.duyng-portfolio.com   # comma-separated CORS override for /evaluate-challenge*
# EVAL_FAKE_JUDGE=0                 # TEST ONLY: 1 replaces the model with a deterministic fake judge
