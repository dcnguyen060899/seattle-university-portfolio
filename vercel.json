{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "functions": {
    "api/index.py": {
      "maxDuration": 60,
      "memory": 1024,
      "excludeFiles": "{public/**,app/**,components/**,lib/**,hooks/**,data/**,scripts/**,resume/**,node_modules/**,.next/**}"
    },
    "app/api/agent/brief/route.ts": {
      "maxDuration": 60,
      "memory": 1024
    },
    "app/api/agent/qa/route.ts": {
      "maxDuration": 30,
      "memory": 1024
    }
  },
  "rewrites": [
    {
      "source": "/evaluate-challenge",
      "destination": "/api/index"
    },
    {
      "source": "/evaluate-challenge/(.*)",
      "destination": "/api/index"
    }
  ]
}
