# Second Brain Configuration
# Copy this file to .env and fill in your values

# =============================================================================
# APPLICATION
# =============================================================================
DEBUG=true
SECRET_KEY=your-secret-key-change-in-production-use-a-long-random-string

# =============================================================================
# DATABASE
# =============================================================================
# Local development (with Docker Compose)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/secondbrain

# Production (use your cloud database URL)
# DATABASE_URL=postgresql+asyncpg://user:password@host:5432/database

# =============================================================================
# VECTOR DATABASE (Qdrant)
# =============================================================================
# Local development
QDRANT_HOST=localhost
QDRANT_PORT=6333

# Production (Qdrant Cloud)
# QDRANT_HOST=your-cluster.qdrant.io
# QDRANT_PORT=6333
# QDRANT_API_KEY=your-qdrant-api-key

# =============================================================================
# REDIS
# =============================================================================
# Local development
REDIS_URL=redis://localhost:6379/0

# Production (Redis Cloud / Upstash)
# REDIS_URL=redis://user:password@host:6379/0

# =============================================================================
# AI SERVICES
# =============================================================================
# Anthropic Claude API (required)
ANTHROPIC_API_KEY=your-anthropic-api-key
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# Voyage AI Embeddings (required)
VOYAGE_API_KEY=your-voyage-api-key
VOYAGE_MODEL=voyage-2

# =============================================================================
# OPTIONAL CONFIGURATION
# =============================================================================
# CORS origins (comma-separated)
# CORS_ORIGINS=http://localhost:3000,https://your-domain.com

# Rate limiting
# RATE_LIMIT_PER_MINUTE=60

# Embedding settings
# EMBEDDING_DIMENSION=1024
# MAX_CHUNK_TOKENS=512
