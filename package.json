{
  "name": "duyng-portfolio",
  "version": "0.1.0",
  "private": true,
  "description": "Duy Nguyen — M.S. Data Science, Seattle University. Portfolio + recruiter fit agent.",
  "license": "MIT",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "dev:py": "FLASK_APP=api/index.py python -m flask run -p 5328",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "check:env": "node scripts/check-env.mjs",
    "check:tokens": "node scripts/check-ground-tokens.mjs",
    "check:hero": "node scripts/check-hero-contrast.mjs",
    "verify": "npm run check:env && npm run check:tokens && npm run check:hero && npm run verify:hero && npm run verify:logo && npm run verify:corpus && npm run gen:resume -- --check && npm run lint && npm run typecheck && npm run test",
    "verify:urls": "bash scripts/verify-urls.sh",
    "verify:corpus": "node scripts/verify-corpus.mjs",
    "verify:hero": "node scripts/verify-hero-assets.mjs",
    "verify:logo": "node scripts/gen-logo-paths.mjs --check",
    "corpus:refresh:fischer": "node scripts/corpus-refresh-fischer.mjs",
    "gen:hero": "node scripts/gen-hero-photo.mjs",
    "gen:logo": "node scripts/gen-logo-paths.mjs",
    "gen:resume": "node scripts/gen-resume.mjs",
    "build:canned": "node scripts/build-canned.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.117.1",
    "framer-motion": "^13.1.0",
    "next": "^16.3.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "server-only": "^0.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "axe-core": "^4.13.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.1",
    "sharp": "^0.35.4",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.10"
  }
}
